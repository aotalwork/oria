<%= link_to(local_assigns.fetch(:path, "#"), class: "block") do %>

  <div class="rounded-2xl bg-white p-6 shadow hover:shadow-xl transition duration-300 border hover:border-blue-500 h-full">

    <div class="text-5xl mb-4">
      <%= icon %>
    </div>

    <h2 class="text-xl font-bold text-gray-900">
      <%= title %>
    </h2>

    <p class="mt-2 text-gray-600">
      <%= description %>
    </p>

  </div>

<% end %>