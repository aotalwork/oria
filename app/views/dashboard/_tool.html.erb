<%= link_to(path || "#", class: "block") do %>

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-lg hover:border-blue-500 transition duration-300 h-full">

    <div class="text-5xl mb-4">
      <%= icon %>
    </div>

    <h2 class="text-xl font-bold text-gray-900">
      <%= title %>
    </h2>

    <p class="mt-2 text-gray-600">
      <%= description %>
    </p>

  </div>

<% end %>