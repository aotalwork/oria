<div class="max-w-7xl mx-auto px-6 py-10">

  <div class="mb-10">

    <h1 class="text-4xl font-bold">
      ¡Hola, <%= current_user.email %>! 👋
    </h1>

    <p class="text-gray-600 mt-2">
      Bienvenido a ORIA. ¿Qué quieres hacer hoy?
    </p>

  </div>

  <div class="grid grid-cols-3 gap-6 mb-10">

    <div class="bg-white rounded-xl p-6 shadow">
      <p class="text-gray-500">Tareas</p>
      <h2 class="text-3xl font-bold"><%= @total_tasks %></h2>
    </div>

    <div class="bg-white rounded-xl p-6 shadow">
      <p class="text-gray-500">Pendientes</p>
      <h2 class="text-3xl font-bold"><%= @pending_tasks %></h2>
    </div>

    <div class="bg-white rounded-xl p-6 shadow">
      <p class="text-gray-500">Completadas</p>
      <h2 class="text-3xl font-bold"><%= @completed_tasks %></h2>
    </div>

  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

    <% @tools.each do |tool| %>
      <%= render "tool", **tool %>
    <% end %>

  </div>

</div>