<div class="max-w-2xl mx-auto">

  <!-- VOLVER -->

  <%= link_to ai_procrastinations_path,
              class: "inline-flex items-center mb-6 text-gray-500 hover:text-gray-900 transition-colors duration-200",
              aria: { label: "Volver a tareas" } do %>

    ```
    <svg xmlns="http://www.w3.org/2000/svg"
         class="w-5 h-5"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
      <path d="M19 12H5"/>
      <path d="M12 19l-7-7 7-7"/>
    </svg>
    ```

  <% end %>

  <!-- TAREA -->

  <div class="flex overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-all hover:shadow-md">

    ```
    <!-- INDICADOR -->
    <div class="w-1.5 shrink-0 bg-indigo-500"></div>

    <div class="flex-1 p-5 sm:p-6">

      <div class="flex items-start justify-between gap-4">

        <div class="min-w-0">

          <div class="mb-2 flex items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-600">
          Anti procrastinación
        </span>
          </div>

          <h1 class="break-words text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
            <%= @procrastination.task %>
          </h1>

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-400">

        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
          Generado por ORIA
        </span>

            <% if @procrastination.created_at.present? %>
          <span>
            <%= l(@procrastination.created_at, format: :short) %>
          </span>
            <% end %>

          </div>

        </div>

      </div>

    </div>
    ```

  </div>

  <!-- SEPARACIÓN -->

  <div class="h-8"></div>

  <!-- PRIMER PASO -->

  <div class="overflow-hidden rounded-xl border border-indigo-200 bg-white shadow-sm">

    ```
    <!-- CABECERA -->
    <div class="border-b border-indigo-100 bg-indigo-50 px-6 py-5">

      <div class="flex items-center gap-3">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-white shadow-sm">
          <span class="text-lg">1</span>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-indigo-500">
            Empieza aquí
          </p>

          <h2 class="mt-0.5 text-xl font-bold text-gray-900">
            Tu primer paso
          </h2>
        </div>

      </div>

    </div>


    <!-- CONTENIDO -->
    <div class="p-6">

      <p class="text-xl font-semibold leading-8 text-gray-900 sm:text-2xl">
        <%= @procrastination.first_step %>
      </p>


      <% if @procrastination.estimated_minutes.present? %>

        <div class="mt-6 flex items-center gap-3">

          <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gray-100">
            <svg class="h-4 w-4 text-gray-500"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9"/>
              <path stroke-linecap="round" d="M12 7v5l3 2"/>
            </svg>
          </div>

          <div>
            <p class="text-xs text-gray-400">
              Tiempo estimado
            </p>

            <p class="text-sm font-semibold text-gray-700">
              <%= @procrastination.estimated_minutes %> minutos
            </p>
          </div>

        </div>

      <% end %>

    </div>
    ```

  </div>

  <!-- SEPARACIÓN -->

  <div class="h-6"></div>

  <!-- MOTIVACIÓN -->

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">

    ```
    <div class="flex items-start gap-4">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-50">
        <span class="text-lg">💬</span>
      </div>

      <div class="min-w-0">

        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">
          ORIA te recuerda
        </p>

        <h2 class="mt-1 text-lg font-bold text-gray-900">
          No tienes que terminar
        </h2>

        <p class="mt-3 leading-7 text-gray-600">
          <%= @procrastination.motivation %>
        </p>

      </div>

    </div>
    ```

  </div>

  <!-- SEPARACIÓN -->

  <div class="h-6"></div>

  <!-- BLOQUEO -->

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">

    ```
    <div class="flex items-start gap-4">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-50">
        <span class="text-lg">🧱</span>
      </div>

      <div class="min-w-0 flex-1">

        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">
          Plan de emergencia
        </p>

        <h2 class="mt-1 text-lg font-bold text-gray-900">
          ¿Te has bloqueado?
        </h2>

        <p class="mt-2 text-sm text-gray-500">
          Si no sabes cómo continuar, haz únicamente esto:
        </p>

        <div class="mt-4 rounded-xl bg-gray-50 p-4">

          <div class="flex items-start gap-3">

        <span class="mt-0.5 text-indigo-500">
          →
        </span>

            <p class="leading-7 text-gray-700">
              <%= @procrastination.blocker_plan %>
            </p>

          </div>

        </div>

      </div>

    </div>
    ```

  </div>

  <!-- SEPARACIÓN -->

  <div class="h-6"></div>

  <!-- RECORDATORIO FINAL -->

  <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 text-center">

    ```
    <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-sm">
      🚀
    </div>

    <h2 class="mt-3 font-semibold text-gray-900">
      Solo empieza.
    </h2>

    <p class="mx-auto mt-1 max-w-sm text-sm leading-6 text-gray-500">
      No necesitas motivación para terminar.
      Solo necesitas dar el primer paso.
    </p>
    ```

  </div>

</div>
