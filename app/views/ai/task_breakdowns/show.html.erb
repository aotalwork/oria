<% status_color = case @task.status.to_s
                  when "pending"
                    "#d1d5db"
                  when "completed"
                    "#22c55e"
                  else
                    "#d1d5db"
                  end %>

<% status_name = case @task.status.to_s
                 when "pending"
                   "Pendiente"
                 when "completed"
                   "Completada"
                 else
                   "Sin estado"
                 end %>

<div class="max-w-2xl mx-auto">

  <% priority_color = case @task.priority
                      when 3 then "bg-red-500"
                      when 2 then "bg-yellow-400"
                      else "bg-gray-300"
                      end %>

  <% priority_name = case @task.priority
                     when 3 then "Alta"
                     when 2 then "Media"
                     else "Baja"
                     end %>


  <!-- VOLVER -->
  <%= link_to ai_task_breakdowns_path,
              class: "inline-flex items-center mb-6 text-gray-500 hover:text-gray-900 transition-colors duration-200",
              aria: { label: "Volver a tareas" } do %>

    <svg xmlns="http://www.w3.org/2000/svg"
         class="w-5 h-5"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">

      <path d="M19 12H5"/>
      <path d="M12 19l-7-7 7-7"/>

    </svg>

  <% end %>


  <!-- TARJETA DE LA TAREA -->
  <div class="flex border border-gray-200 rounded-xl overflow-hidden bg-white hover:shadow-md transition-all">

    <div class="w-1.5 <%= priority_color %> shrink-0"></div>

    <div class="flex-1 p-5">

      <div class="flex justify-between items-start gap-4">

        <div class="min-w-0">

          <h1 class="text-3xl font-bold">
            <%= @task.title %>
          </h1>

          <p class="mt-1 text-sm text-gray-500">
            <%= @task.description %>
          </p>

          <div class="mt-3 flex items-center gap-4 text-xs text-gray-400">

            <!-- PRIORIDAD -->
            <span class="flex items-center gap-1">

              <span class="w-1.5 h-1.5 rounded-full <%= priority_color %>"></span>

              Prioridad <%= priority_name %>

            </span>


            <!-- ESTADO -->
            <span class="flex items-center gap-1">

              <span
                class="w-1.5 h-1.5 rounded-full inline-block"
                style="background-color: <%= status_color %>;">
              </span>

              Estado <%= status_name %>

            </span>


            <% if @task.due_date.present? %>

              <!-- FECHA -->

              <span class="flex items-center gap-1">

                <svg class="w-3.5 h-3.5"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     viewBox="0 0 24 24">

                  <path stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>

                </svg>

                <%= l(@task.due_date, format: :short) %>

              </span>

            <% end %>

          </div>

        </div>


        <!-- EDITAR -->
        <%= link_to edit_ai_task_breakdown_path(@task),
                    title: "Editar",
                    class: "p-2 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors shrink-0" do %>

          <svg class="w-4 h-4"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               viewBox="0 0 24 24">

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 13.5v4.5a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V8.25A2.25 2.25 0 016 6h4.5"/>

          </svg>

        <% end %>

      </div>

    </div>

  </div>


  <!-- ESPACIO REAL ENTRE TARJETAS -->
  <div class="h-10"></div>


  <!-- PLAN GENERADO -->
  <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">

    <!-- CABECERA -->
    <div class="pb-6">

      <h2 class="font-bold text-xl">
        Plan generado por ORIA
      </h2>

      <p class="text-sm text-gray-500 mt-2">
        Sigue estos pasos para completar la tarea.
      </p>

    </div>


    <!-- PASOS -->
    <div class="pt-6">

      <div class="space-y-6">

        <% @task_steps.each do |step| %>

          <!-- PASO -->
          <div class="rounded-xl border border-gray-200 p-5 bg-white hover:border-gray-300 hover:shadow-sm transition-all">

            <div class="flex items-start gap-4">

              <!-- NÚMERO -->
              <div class="flex items-center justify-center w-8 h-8 rounded-full text-gray-700 font-bold shrink-0">

                <%= step.position %>

              </div>


              <!-- CONTENIDO -->
              <div class="flex-1 min-w-0">

                <h3 class="font-semibold text-lg">
                  <%= step.title %>
                </h3>

                <p class="text-gray-600 mt-2 leading-relaxed">
                  <%= step.description %>
                </p>

                <p class="text-sm text-gray-400 mt-3">
                  <%= step.estimated_minutes %> min
                </p>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    </div>

  </div>

</div>