<div class="max-w-2xl mx-auto">

  <%= link_to ai_task_breakdowns_path,
              class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-6" do %>
    ← Volver a tareas
  <% end %>

  <div class="border border-gray-200 rounded-xl p-6 bg-white">

    <h1 class="text-2xl font-bold text-gray-900">
      <%= @task.title %>
    </h1>

    <p class="mt-3 text-gray-600">
      <%= @task.description %>
    </p>

    <div class="mt-4 flex items-center gap-4 text-sm text-gray-500">
      <span>Prioridad: <strong><%= @task.priority %></strong></span>

      <% if @task.due_date.present? %>
        <span>Fecha: <%= l(@task.due_date, format: :short) %></span>
      <% end %>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-100 flex gap-2">
      <%= link_to "Editar", edit_ai_task_breakdown_path(@task),
                  class: "px-3 py-1.5 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100 transition-colors" %>
    </div>

  </div>

</div>