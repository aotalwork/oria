<div class="max-w-2xl mx-auto">
  <% priority_color = case @task.priority
                      when 3 then "bg-red-500"
                      when 2 then "bg-yellow-400"
                      else "bg-gray-300"
                      end %>
  <% priority_name = case @task.priority
                     when 3 then "Alta"
                     when 2 then "Media"
                     else "baja"
                     end %>
  <%= link_to ai_task_breakdowns_path,
              class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 transition-colors mb-6" do %>
    ← Volver a tareas
  <% end %>
  <div class="flex border border-gray-200 rounded-xl overflow-hidden hover:shadow-md hover:border-gray-300 transition-all bg-white">

    <div class="w-1.5 <%= priority_color %> shrink-0"></div>

    <div class="flex-1 p-5">

      <div class="flex justify-between items-start gap-4">

        <div class="min-w-0">
          <h2 class="text-lg font-semibold text-gray-900 truncate">
            <%= @task.title %>
          </h2>

          <p class="mt-1 text-sm text-gray-500 line-clamp-2">
            <%= @task.description %>
          </p>

          <div class="mt-3 flex items-center gap-4 text-xs text-gray-400">
                <span class="flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full <%= priority_color %>"></span>
                  Prioridad <%= priority_name %>
                </span>

            <% if @task.due_date.present? %>
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= l(@task.due_date, format: :short) %>
                  </span>
            <% end %>
          </div>
        </div>



      </div>
      <%= link_to edit_ai_task_breakdown_path(@task),
                  title: "Editar",
                  class: "p-2 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5v4.5a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V8.25A2.25 2.25 0 016 6h4.5"/>
        </svg>
      <% end %>
    </div>

  </div>
  <div class="space-y-6">

    <h1 class="text-3xl font-bold">
      <%= @task.title %>
    </h1>


    <div class="bg-white rounded-lg p-6 shadow">

      <h2 class="font-bold text-xl mb-4">
        Plan generado por ORIA
      </h2>
      <div class="prose prose-gray max-w-none">
        <%= markdown(@breakdown.response) %>
      </div>

    </div>


  </div>
</div>
