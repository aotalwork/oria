<%= form_with model: @task do |f| %>

  <div class="space-y-6 max-w-2xl">

    <div>
      <%= f.label :title,
                  "¿Qué tarea necesitas dividir?",
                  class: "block font-medium mb-2" %>

      <%= f.text_field :title,
                       placeholder: "Ej: Preparar declaración de la renta",
                       class: "w-full rounded-lg border p-3" %>
    </div>

    <div>
      <%= f.label :description,
                  "Añade contexto (opcional)",
                  class: "block font-medium mb-2" %>

      <%= f.text_area :description,
                      rows: 4,
                      placeholder: "Ej: Nunca he hecho la declaración y no sé por dónde empezar",
                      class: "w-full rounded-lg border p-3" %>
    </div>

    <div class="grid grid-cols-2 gap-4 max-w-2xl">

      <div>
        <%= f.label :priority, "Prioridad" %>

        <%= f.select :priority,
                     [
                       ["Baja", 1],
                       ["Media", 2],
                       ["Alta", 3]
                     ],
                     {},
                     class: "w-full rounded-lg border p-3" %>
      </div>

      <div>
        <%= f.label :estimated_minutes, "Minutos estimados" %>

        <%= f.number_field :estimated_minutes,
                           class: "w-full rounded-lg border p-3" %>
      </div>

    </div>

    <div>
      <%= f.label :due_date, "Fecha límite" %>

      <%= f.datetime_local_field :due_date,
                                 class: "w-full max-w-2xl rounded-lg border p-3" %>
    </div>

    <%= f.submit(
          @task.persisted? ? "Guardar y regenerar con IA" : "🧠 Dividir con IA",
          class: "bg-blue-600 text-white px-6 py-3 rounded-lg cursor-pointer"
        ) %>

  </div>

<% end %>