<%= form_with model: @task,
              url: @task.new_record? ? ai_task_breakdowns_path : ai_task_breakdown_path(@task),
              method: @task.new_record? ? :post : :patch do |f| %>

  <div class="space-y-6">

    <div>
      <%= f.label :title, "Título", class: "block font-medium mb-2" %>

      <%= f.text_field :title,
                       class: "w-full max-w-2xl rounded-lg border p-3" %>
    </div>


    <div>
      <%= f.label :description, "Descripción", class: "block font-medium mb-2" %>

      <%= f.text_area :description,
                      rows: 5,
                      class: "w-full max-w-2xl rounded-lg border p-3" %>
    </div>


    <div class="grid grid-cols-2 gap-4 max-w-2xl">

      <div>
        <%= f.label :priority, "Prioridad" %>

        <%= f.select :priority,
                     [
                       ["Baja", 1],
                       ["Media", 2],
                       ["Alta", 3]
                     ],
                     {},
                     class: "w-full rounded-lg border p-3" %>
      </div>


      <div>
        <%= f.label :estimated_minutes, "Minutos estimados" %>

        <%= f.number_field :estimated_minutes,
                           class: "w-full rounded-lg border p-3" %>
      </div>

    </div>


    <div>
      <%= f.label :due_date, "Fecha límite" %>

      <%= f.datetime_local_field :due_date,
                                 class: "w-full max-w-2xl rounded-lg border p-3" %>
    </div>


    <%= f.submit "Guardar tarea",
                 class: "bg-blue-600 text-white px-6 py-3 rounded-lg" %>

  </div>

<% end %>