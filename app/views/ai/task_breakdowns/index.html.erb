<div class="flex justify-between items-center mb-8">

  <div>
    <h1 class="text-3xl font-bold text-gray-900">
      Mis tareas
    </h1>
    <p class="mt-1 text-sm text-gray-500">
      <%= pluralize(@tasks.count, "tarea") %> en total
    </p>
  </div>

  <%= link_to new_ai_task_breakdown_path,
              class: "flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg font-medium text-sm hover:bg-blue-700 transition-colors shadow-sm" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
    </svg>
    Nueva tarea
  <% end %>

</div>

<% if @tasks.any? %>

  <div class="space-y-3">

    <% @tasks.each do |task| %>

      <% priority_color = case task.priority
                          when "alta" then "bg-red-500"
                          when "media" then "bg-yellow-400"
                          else "bg-gray-300"
                          end %>

      <div class="flex border border-gray-200 rounded-xl overflow-hidden hover:shadow-md hover:border-gray-300 transition-all bg-white">

        <div class="w-1.5 <%= priority_color %> shrink-0"></div>

        <div class="flex-1 p-5">

          <div class="flex justify-between items-start gap-4">

            <div class="min-w-0">
              <h2 class="text-lg font-semibold text-gray-900 truncate">
                <%= task.title %>
              </h2>

              <p class="mt-1 text-sm text-gray-500 line-clamp-2">
                <%= task.description %>
              </p>

              <div class="mt-3 flex items-center gap-4 text-xs text-gray-400">
                <span class="flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full <%= priority_color %>"></span>
                  Prioridad <%= task.priority %>
                </span>

                <% if task.due_date.present? %>
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= l(task.due_date, format: :short) %>
                  </span>
                <% end %>
              </div>
            </div>

            <div class="flex items-center gap-1 shrink-0">

              <%= link_to ai_task_breakdown_path(task),
                          title: "Ver",
                          class: "p-2 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              <% end %>

              <%= link_to edit_ai_task_breakdown_path(task),
                          title: "Editar",
                          class: "p-2 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5v4.5a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V8.25A2.25 2.25 0 016 6h4.5"/>
                </svg>
              <% end %>

              <%= button_to ai_task_breakdown_path(task),
                            method: :delete,
                            data: { turbo_confirm: "¿Eliminar?" },
                            title: "Eliminar",
                            class: "p-2 rounded-lg text-gray-400 hover:bg-red-50 hover:text-red-600 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.166m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                </svg>
              <% end %>

            </div>

          </div>

        </div>

      </div>

    <% end %>

  </div>

<% else %>

  <div class="text-center py-20 border border-dashed border-gray-300 rounded-xl">
    <svg class="w-10 h-10 mx-auto text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
    </svg>
    <p class="mt-3 text-gray-500">Todavía no tienes tareas.</p>
    <%= link_to "Crea la primera", new_ai_task_breakdown_path, class: "mt-2 inline-block text-blue-600 font-medium hover:underline text-sm" %>
  </div>

<% end %>