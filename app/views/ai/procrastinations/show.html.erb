
<div class="max-w-2xl mx-auto">

  <!-- VOLVER -->
  <%= link_to ai_procrastinations_path,
              class: "inline-flex items-center mb-8 text-gray-500 hover:text-gray-900 transition-colors duration-200",
              aria: { label: "Volver a tareas" } do %>

    <svg xmlns="http://www.w3.org/2000/svg"
         class="w-5 h-5"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
      <path d="M19 12H5"/>
      <path d="M12 19l-7-7 7-7"/>
    </svg>

  <% end %>

  <!-- TARJETA DE LA TAREA -->
  <div class="flex border border-gray-200 rounded-xl overflow-hidden bg-white hover:shadow-md transition-all">

    <div class="w-1.5 <%= 'blue' %> shrink-0"></div>

    <div class="flex-1 p-5">

      <div class="flex justify-between items-start gap-4">

        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
            Anti procrastinación
          </p>
          <h1 class="text-3xl font-bold">
            <%= @procrastination.task %>
          </h1>



          <div class="mt-3 flex items-center gap-4 text-xs text-gray-400">




          </div>

        </div>


        <!-- EDITAR -->
        <%= link_to edit_ai_procrastination_path(@procrastination),
                    title: "Editar",
                    class: "p-2 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors shrink-0" do %>

          <svg class="w-4 h-4"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               viewBox="0 0 24 24">

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/>

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 13.5v4.5a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V8.25A2.25 2.25 0 016 6h4.5"/>

          </svg>

        <% end %>

      </div>

    </div>

  </div>


  <!-- TAREA -->

  <div class="h-10"></div>
  <h2 class="text-lg font-bold text-gray-900">
    Tu primer paso
  </h2>
  <p class="mt-1 text-sm text-gray-500">
    Empieza por algo pequeño. No tienes que terminar la tarea.
  </p>
  <div class="h-10"></div>

  <!-- PRIMER PASO -->
  <section class="mt-10 rounded-xl border border-gray-200 bg-white shadow-sm">

    <div class="px-6 py-5">



    </div>


    <div class="p-6">

        <p class="text-lg font-semibold leading-7 text-gray-900">
          <%= @procrastination.first_step %>
        </p>


      <% if @procrastination.estimated_minutes.present? %>

        <div class="mt-5 flex items-center gap-2 text-sm text-gray-500">

          <svg class="h-4 w-4"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"/>
            <path stroke-linecap="round" d="M12 7v5l3 2"/>
          </svg>

          <span>
            Solo
            <strong class="text-gray-700">
              <%= @procrastination.estimated_minutes %>
              minuto<%= @procrastination.estimated_minutes == 1 ? "" : "s" %>
            </strong>
          </span>

        </div>

      <% end %>

    </div>

  </section>

  <div class="h-10"></div>

  <h2 class="mt-1 text-lg font-bold text-gray-900">
    Recuerda
  </h2>
  <p class="mt-1 text-sm text-gray-500">
    Motivación 💪
  </p>
  <div class="h-10"></div>
  <!-- MOTIVACIÓN -->
  <section class="mt-8 rounded-xl border border-gray-200 bg-white shadow-sm">

    <div class="p-6">

      <div class="flex items-start gap-4">



        <div class="min-w-0">



          <p class="mt-3 leading-7 text-gray-600">
            <%= @procrastination.motivation %>
          </p>

        </div>

      </div>

    </div>

  </section>
  <div class="h-10"></div>
  <h2 class="mt-1 text-lg font-bold text-gray-900">
    ¿Te has bloqueado?
  </h2>
  <p class="mt-1 text-sm text-gray-500">
    Si te bloqueas 🧱  No intentes forzarlo. Haz esto.
  </p>
  <div class="h-10"></div>
  <!-- BLOQUEO -->
  <section class="mt-8 rounded-xl border border-gray-200 bg-white shadow-sm">

    <div class="p-6">

      <div class="flex items-start gap-4">


        <div class="min-w-0 flex-1">

          <div class="mt-5 rounded-xl bg-gray-50 px-5 py-4">

            <p class="leading-7 text-gray-700">
              <%= @procrastination.blocker_plan %>
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>

  <div class="h-10"></div>
  <!-- RECORDATORIO -->
  <section class="mt-8 mb-12 rounded-xl  bg-indigo-50">

    <div class="flex items-start gap-4 p-6">

      <div class="flex h-10 w-10 shrink-0 items-center justify-center">
        🎯
      </div>

      <div>

        <p class="font-semibold text-gray-900">
          No tienes que terminarla.
        </p>

        <p class="mt-1 text-sm leading-6 text-gray-600">
          Concéntrate únicamente en hacer el primer paso.
        </p>

      </div>

    </div>

  </section>

</div>
