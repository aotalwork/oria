<div class="max-w-2xl mx-auto">

  <!-- VOLVER -->
  <%= link_to ai_procrastinations_path,
              class: "inline-flex items-center gap-2 mb-6 text-sm text-gray-500 hover:text-gray-900 transition-colors",
              aria: { label: "Volver a tareas" } do %>

    <svg xmlns="http://www.w3.org/2000/svg"
         class="w-4 h-4"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">
      <path d="M19 12H5"/>
      <path d="M12 19l-7-7 7-7"/>
    </svg>



  <% end %>


  <!-- TAREA -->
  <div class="flex overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

    <div class="w-1 shrink-0 bg-indigo-500"></div>

    <div class="flex-1 p-5">

      <span class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
        Anti procrastinación
      </span>

      <h1 class="mt-2 text-2xl font-bold text-gray-900">
        <%= @procrastination.task %>
      </h1>

      <div class="mt-3 flex items-center gap-4 text-xs text-gray-400">

        <span class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
          Generado por ORIA
        </span>

        <% if @procrastination.created_at.present? %>
          <span>
            <%= l(@procrastination.created_at, format: :short) %>
          </span>
        <% end %>

      </div>

    </div>
  </div>


  <!-- PRIMER PASO -->
  <div class="mt-8 rounded-xl border border-gray-200 bg-white shadow-sm">

    <div class="border-b border-gray-100 px-6 py-5">

      <div class="flex items-center gap-3">

        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-lg">
          🚀
        </div>

        <div>
          <h2 class="font-bold text-lg text-gray-900">
            Tu primer paso
          </h2>

          <p class="mt-0.5 text-sm text-gray-500">
            Empieza por algo pequeño.
          </p>
        </div>

      </div>

    </div>


    <div class="p-6">

      <div class="rounded-lg bg-gray-50 px-5 py-4">

        <p class="text-lg font-semibold leading-7 text-gray-900">
          <%= @procrastination.first_step %>
        </p>

      </div>


      <% if @procrastination.estimated_minutes.present? %>

        <div class="mt-4 flex items-center gap-2 text-sm text-gray-500">

          <svg class="h-4 w-4"
               fill="none"
               stroke="currentColor"
               stroke-width="2"
               viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"/>
            <path stroke-linecap="round" d="M12 7v5l3 2"/>
          </svg>

          <span>
            Solo <strong class="text-gray-700"><%= @procrastination.estimated_minutes %> minuto<%= @procrastination.estimated_minutes == 1 ? "" : "s" %></strong>
          </span>

        </div>

      <% end %>

    </div>

  </div>


  <!-- MOTIVACIÓN -->
  <div class="mt-5 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">

    <div class="flex items-start gap-4">

      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-yellow-50">
        💪
      </div>

      <div>

        <h2 class="font-bold text-lg text-gray-900">
          Recuerda
        </h2>

        <p class="mt-2 leading-7 text-gray-600">
          <%= @procrastination.motivation %>
        </p>

      </div>

    </div>

  </div>


  <!-- BLOQUEO -->
  <div class="mt-5 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">

    <div class="flex items-start gap-4">

      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-50">
        🧱
      </div>

      <div class="flex-1">

        <h2 class="font-bold text-lg text-gray-900">
          ¿Te has bloqueado?
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          No intentes forzarlo. Haz esto.
        </p>

        <div class="mt-4 rounded-lg bg-gray-50 px-4 py-3">

          <p class="text-gray-700 leading-6">
            <%= @procrastination.blocker_plan %>
          </p>

        </div>

      </div>

    </div>

  </div>


  <!-- RECORDATORIO -->
  <div class="mt-5 mb-10 rounded-xl border border-indigo-100 bg-indigo-50 px-6 py-5">

    <div class="flex items-start gap-3">

      <span class="text-lg">
        🎯
      </span>

      <div>

        <p class="font-semibold text-gray-900">
          No tienes que terminarla.
        </p>

        <p class="mt-1 text-sm leading-6 text-gray-600">
          Concéntrate únicamente en hacer el primer paso.
        </p>

      </div>

    </div>

  </div>

</div>