<%= form_with model: @task do |f| %>

  <div class="space-y-6">

    <div>
      <%= f.label :title, class: "block font-medium mb-2" %>
      <%= f.text_field :title,
                       class: "w-full rounded-lg border p-3" %>
    </div>

    <div>
      <%= f.label :description, class: "block font-medium mb-2" %>
      <%= f.text_area :description,
                      rows: 5,
                      class: "w-full rounded-lg border p-3" %>
    </div>

    <div class="grid grid-cols-2 gap-4">

      <div>
        <%= f.label :priority %>
        <%= f.number_field :priority,
                           class: "w-full rounded-lg border p-3" %>
      </div>

      <div>
        <%= f.label :estimated_minutes %>
        <%= f.number_field :estimated_minutes,
                           class: "w-full rounded-lg border p-3" %>
      </div>

    </div>

    <div>
      <%= f.label :due_date %>
      <%= f.datetime_local_field :due_date,
                                 class: "w-full rounded-lg border p-3" %>
    </div>

    <%= f.submit class: "bg-blue-600 text-white px-6 py-3 rounded-lg" %>

  </div>

<% end %>